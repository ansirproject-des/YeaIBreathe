// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Mood {
  stressed
  anxious
  focus
}

enum Tech {
  box_4444
  breathing_478
}

enum SessionStatus {
  in_progress
  completed
}

enum CheckIn {
  better
  same
  tense
}

enum Language {
  en
  uk
}

enum PostType {
  reflection
  practice
  tip
}

enum PostVisibility {
  anyone
  followers_only
}

enum CommentPermission {
  anyone
  followers_only
}

enum PostAuthorType {
  public
  anonymous
}

enum PostAttachmentType {
  media
  audio
  document
}

enum NotificationType {
  follow
  comment
  like
}


model User {
  id                          String              @id @default(cuid())

  clerkId                     String              @unique 
  email                       String

  firstName                   String?

  username                    String              @unique
  displayName                 String

  description                 String?
  bio                         String?
  links                       UserLink[]

  postComments                PostComment[]
  postLikes                   PostLike[]
  postBookmarks               PostBookmark[]
  commentLikes                PostCommentLike[]

  followers                   Follow[]            @relation("UserFollowers")
  following                   Follow[]            @relation("UserFollowing")

  notificationsReceived       Notification[]      @relation("NotificationTarget")
  notificationsSent           Notification[]      @relation("NotificationActor")

  avatar                      String?

  onboardingCompleted         Boolean             @default(false)
  postHistoryInfoDismissed    Boolean             @default(false)

  sessions                    Session[]
  posts                       Post[]

  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  preferredLanguage           Language            @default(en)
}

model UserLink {
  id        String          @id @default(cuid())

  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?
  url       String 

  order     Int             @default(0)

  createdAt DateTime        @default(now())
}

model Session {
  id          String         @id @default(cuid())

  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)  

  mood        Mood
  tech        Tech
  duration    Int
  notes       String?
  checkIn     CheckIn?
  status      SessionStatus  @default(in_progress)

  createdAt   DateTime       @default(now())   
}

model Post {
  id                   String               @id @default(cuid())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  title                String?
  content              String?
  attachments          PostAttachment[]

  comments             PostComment[]
  likes                PostLike[]
  postBookmarks        PostBookmark[]
  notifications        Notification[]

  type                 PostType

  duration             Int?
  category             String?

  visibility           PostVisibility       @default(anyone)
  commentPermission    CommentPermission    @default(anyone)
  authorType           PostAuthorType       @default(public)
}

model PostAttachment {
  id         String             @id @default(cuid())

  postId     String
  post       Post               @relation(fields: [postId], references: [id], onDelete: Cascade)

  type       PostAttachmentType

  key        String
  fileName   String

  order      Int

  createdAt  DateTime           @default(now())
}

model PostComment {
  id                    String                    @id @default(cuid())
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  postId                String
  post                  Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId                String
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  content               String?                   @db.Text
  attachments           PostCommentAttachment[]
  likes                 PostCommentLike[]
  postBookmarks         PostBookmark[]
  notifications         Notification[]

  authorType            PostAuthorType            @default(public)

  isDeleted             Boolean                   @default(false)
  deletedAt             DateTime?

  parentId              String?                   
  parent                PostComment?              @relation("CommentReplies", fields: [parentId], references: [id] )
  replies               PostComment[]             @relation("CommentReplies")


  visibility            PostVisibility            @default(anyone)
  commentPermission     CommentPermission         @default(anyone)
}

model PostLike {
  id        String        @id @default(cuid())

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostBookmark {
  id        String      @id @default(cuid())

  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId    String?
  post      Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model PostCommentAttachment {
  id              String          @id @default(cuid())

  commentId       String
  comment         PostComment     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  key             String
  fileName        String
  type            PostAttachmentType

  createdAt       DateTime        @default(now())
  order           Int
}

model PostCommentLike {
  id        String          @id @default(cuid())

  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   PostComment     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Follow {
  id                      String            @id @default(cuid())
  createdAt               DateTime          @default(now())

  followerId              String
  follower                User              @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  followingId             String
  following               User              @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id          String            @id @default(cuid())

  targetId    String
  target      User              @relation("NotificationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  actorId     String
  actor       User              @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  postId      String? 
  post        Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId   String?
  comment     PostComment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)

  type        NotificationType
  
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())

}